# Needed only for "Learn from a website" (Knowledge core). Market data and the
# rest of the desk work without it. Copy to .env and fill in.
ANTHROPIC_API_KEY=
PORT=3200

# "Log in with Deriv" (one click, no API token). Register an OAuth app at
# developers.deriv.com with redirect URL http://localhost:3200/oauth/callback
# and put its client ID here (or type it into the App ID box on the page).
DERIV_CLIENT_ID=
# Only if you registered a different redirect URL:
# DERIV_REDIRECT_URI=http://localhost:3200/oauth/callback

# Encrypts the "Log in with Deriv" cookies. Optional locally (a random key is used
# per run); REQUIRED on Vercel so every serverless instance can read the cookies.
# Any long random text, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
